<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드 전용: PC의 로컬 개발 서버(http://<LAN IP>:3000)에 붙도록 평문 허용 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
