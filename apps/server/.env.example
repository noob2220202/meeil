# 서버 환경변수 예시. 복사해서 .env로 쓴다. (.env는 커밋 금지)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://meeil:meeil@localhost:5432/meeil
# 쉼표로 구분한 CORS 허용 오리진(관리자 웹 개발 서버)
CORS_ORIGINS=http://localhost:5173
# access 토큰 서명 키. 운영에서는 `openssl rand -base64 48`로 새로 만든다
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 카카오 개발자 콘솔의 앱 ID(숫자)
KAKAO_APP_ID=
# 구글 OAuth 클라이언트 ID(웹 클라이언트 = 앱의 serverClientId). 쉼표로 여러 개
GOOGLE_CLIENT_IDS=
# 개발용 로그인(/auth/dev). 소셜 키 없이 가입 흐름을 시험할 때만 true. 운영 금지
AUTH_DEV_LOGIN=true
