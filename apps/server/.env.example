# 서버 환경변수 예시. 복사해서 .env로 쓴다. (.env는 커밋 금지)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://meeil:meeil@localhost:5432/meeil
# DB 연결 풀 크기(워커당). 워커 수 × 풀 < PostgreSQL max_connections(100)
DATABASE_POOL_MAX=20
# 서버 워커 프로세스 수(VPS 코어 수까지). 배경 작업은 1번 워커만
WEB_CONCURRENCY=1
# 쉼표로 구분한 CORS 허용 오리진(관리자 웹 개발 서버)
CORS_ORIGINS=http://localhost:5173
# access 토큰 서명 키. 운영에서는 `openssl rand -base64 48`로 새로 만든다
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# 카카오 개발자 콘솔의 앱 ID(숫자)
KAKAO_APP_ID=
# 구글 OAuth 클라이언트 ID(웹 클라이언트 = 앱의 serverClientId). 쉼표로 여러 개
GOOGLE_CLIENT_IDS=
# 개발용 로그인(/auth/dev). 소셜 키 없이 가입 흐름을 시험할 때만 true. 운영 금지
AUTH_DEV_LOGIN=true
# 사진 저장소. 운영은 r2(비공개 버킷) — 사진은 서명 URL로만 내보낸다
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.storage
PUBLIC_BASE_URL=http://localhost:3000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# DB 백업용 비공개 버킷(사진 버킷과 달라야 함). deploy/backup.sh가 쓴다
R2_BACKUP_BUCKET=
# 푸시(FCM HTTP v1 서비스 계정). 비워 두면 서버 로그로만 남긴다
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# 보상형 광고(AdMob) SSV 콜백: https://api.<도메인>/ads/reward-callback 을 AdMob 콘솔 광고 단위에 등록
# 허용할 광고 단위 ID(쉼표 구분, 예: ca-app-pub-xxx/yyy). 비우면 검사하지 않음
ADMOB_AD_UNIT_IDS=

# 관리자 TOTP 시크릿 암호화 키(32자 이상). production 필수
ADMIN_SECRET_KEY=

# 앞단 리버스 프록시(Caddy) 수. X-Forwarded-For를 오른쪽에서 이만큼만 믿는다
TRUST_PROXY_HOPS=1
